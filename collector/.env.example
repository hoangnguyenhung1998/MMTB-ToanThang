COLLECTOR_LISTENER_RECONNECT_COOLDOWN_MS=300000
COLLECTOR_LISTENER_PROBE_INTERVAL_MS=120000
COLLECTOR_LISTENER_PROBE_TIMEOUT_MS=30000
