COLLECTOR_QUEUE_POLL_MS=5000
COLLECTOR_QUEUE_MAX_ATTEMPTS=100
COLLECTOR_SENT_RETENTION_DAYS=7
COLLECTOR_LISTENER_RECONNECT_BASE_MS=1000
COLLECTOR_LISTENER_RECONNECT_MAX_MS=60000
