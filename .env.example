APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Machine intake BCH sender accounts (use Gmail App Passwords, never account passwords)
MACHINE_INTAKE_DEFAULT_SENDER=test
MACHINE_INTAKE_REPLY_TO_ADDRESS=
MACHINE_INTAKE_REPLY_TO_NAME="MMTB Gmail Agent"

MACHINE_INTAKE_TEST_ADDRESS=
MACHINE_INTAKE_TEST_NAME="MMTB Test"
MACHINE_INTAKE_TEST_SCHEME=null
MACHINE_INTAKE_TEST_HOST=smtp.gmail.com
MACHINE_INTAKE_TEST_PORT=587
MACHINE_INTAKE_TEST_USERNAME=
MACHINE_INTAKE_TEST_PASSWORD=

MACHINE_INTAKE_COMPANY_ADDRESS=
MACHINE_INTAKE_COMPANY_NAME="MMTB Công ty"
MACHINE_INTAKE_COMPANY_SCHEME=null
MACHINE_INTAKE_COMPANY_HOST=smtp.gmail.com
MACHINE_INTAKE_COMPANY_PORT=587
MACHINE_INTAKE_COMPANY_USERNAME=
MACHINE_INTAKE_COMPANY_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 private object storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=mmtb-private-media
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Zalo Collector ingestion API
COLLECTOR_API_TOKEN=
COLLECTOR_STORAGE_DISK=local
COLLECTOR_STORAGE_DIRECTORY=zalo
COLLECTOR_MAX_FILE_KILOBYTES=25600
COLLECTOR_RATE_LIMIT_PER_MINUTE=240

# External OCR Worker API
OCR_WORKER_API_TOKEN=
OCR_JOB_LEASE_SECONDS=300
OCR_MINIMUM_CONFIDENCE=0.80
OCR_WORKER_RATE_LIMIT_PER_MINUTE=240

# Gmail machine-intake reply worker
GMAIL_INTAKE_WORKER_TOKEN=
GMAIL_INTAKE_MINIMUM_CONFIDENCE=0.85

# OpenClaw reconciliation agent API
OPENCLAW_RECONCILIATION_API_TOKEN=
OPENCLAW_RECONCILIATION_LEASE_SECONDS=600
OPENCLAW_RATE_LIMIT_PER_MINUTE=120
OPENCLAW_RULES_VERSION=rules-v1
OPENCLAW_MATCH_WINDOW_MINUTES=180
OPENCLAW_TIME_WARNING_MINUTES=30
OPENCLAW_TIME_CRITICAL_MINUTES=60

# Proactive AI reconciliation alerts
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10
MMTB_RECONCILIATION_WAITING_ALERT_HOURS=2
MMTB_RECONCILIATION_ALERT_RETRY_MINUTES=5
MMTB_RECONCILIATION_ALERT_MAX_ATTEMPTS=5
# Optional override; defaults to APP_URL/ai-reconciliation
MMTB_RECONCILIATION_DASHBOARD_URL=

# Automation health dashboard
AUTOMATION_DEGRADED_AFTER_SECONDS=180
AUTOMATION_OFFLINE_AFTER_SECONDS=300
AUTOMATION_CONSECUTIVE_ERRORS=3
AUTOMATION_HUNG_JOB_MINUTES=30
AUTOMATION_COMMAND_LEASE_SECONDS=120
AUTOMATION_DASHBOARD_URL=
